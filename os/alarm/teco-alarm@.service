[Unit]
Description=Teco.Pi alarm %i (Paradox preko IP150, PAI)
After=network-online.target

[Service]
WorkingDirectory=%h/teco/alarm
ExecStart=%h/.local/pai-venv/bin/python %h/teco/alarm/alarm_bridge.py %i
StandardOutput=append:/tmp/teco-alarm-%i.log
StandardError=append:/tmp/teco-alarm-%i.log
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
